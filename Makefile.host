# PC build (SDL2) and developer tool.
#   make -f Makefile.host            -> build/host/pulsedash, build/host/pd_tool
#   make -f Makefile.host test       -> data checks, smoke test, every level solved and
#                                       playable on the beat, coins, palette contrast,
#                                       the title screen's demo run
#   make -f Makefile.host test-full  -> also prove levels beatable at 30 and 20 Hz input
#   make -f Makefile.host PSP=1 ...  -> the same in the PSP's widescreen layout, in
#                                       build/host-psp/ (to try it on a PC)
#   make -f Makefile.host PSP=1 psp-art  -> redraw the PSP's XMB icon and background
#                                       (src/psp/ICON0.PNG, PIC1.PNG)
#   make -f Makefile.host build/host/gbc_tool  -> the Game Boy Color data tool
#                                       (Makefile.gbc builds and uses it)

CC ?= cc
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
SDL_CFLAGS := $(shell sdl2-config --cflags)
SDL_LIBS := $(shell sdl2-config --libs)
CFLAGS ?= -O2 -g
CFLAGS += -std=c99 -D_DEFAULT_SOURCE -Wall -Wextra -Wno-unused-parameter -Wdouble-promotion -Isrc/host $(SDL_CFLAGS)
LDLIBS := $(SDL_LIBS) -lm

ifeq ($(PSP),1)
CFLAGS += -DPD_PSP
OUT := build/host-psp
else
OUT := build/host
endif
include sources.mk
CORE_OBJ := $(patsubst src/%.c,$(OUT)/%.o,$(CORE_SRC))
GAME_OBJ := $(OUT)/host/main_sdl.o $(OUT)/host/gfx_sdl.o
TOOL_OBJ := $(OUT)/host/pd_tool.o $(OUT)/host/solver.o $(OUT)/host/gfx_sdl.o $(OUT)/host/png_write.o
GBC_TOOL_OBJ := $(OUT)/host/gbc_tool.o $(OUT)/host/solver.o $(OUT)/host/gfx_sdl.o $(OUT)/host/png_write.o \
                $(OUT)/gbc/gbsim.o $(OUT)/gbc/gbcells.o $(OUT)/gbc/tileset.o

all: $(OUT)/pulsedash $(OUT)/pd_tool

$(OUT)/pulsedash: $(CORE_OBJ) $(GAME_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

$(OUT)/pd_tool: $(CORE_OBJ) $(TOOL_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

$(OUT)/gbc_tool: $(CORE_OBJ) $(GBC_TOOL_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

$(OUT)/host/%.o: CFLAGS += -Wno-double-promotion

# the version is compiled into one small object, rebuilt every time
$(OUT)/core/version.o: CFLAGS += -DPD_VERSION=\"$(VERSION)\"
$(OUT)/core/version.o: FORCE
FORCE:

$(OUT)/%.o: src/%.c $(wildcard src/core/*.h) $(wildcard src/host/*.h) $(wildcard src/gbc/*.h) src/ps2/target.h src/psp/target.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

test: $(OUT)/pd_tool
	$(OUT)/pd_tool check
	$(OUT)/pd_tool smoke
	$(OUT)/pd_tool solve all 1
	$(OUT)/pd_tool rhythm all
	$(OUT)/pd_tool coins all
	$(OUT)/pd_tool palettes $(OUT)/palettes.bmp 3
	$(OUT)/pd_tool demo

test-full: test
	$(OUT)/pd_tool solve all 3

psp-art: $(OUT)/pd_tool
	@test "$(PSP)" = 1 || { echo "psp-art needs PSP=1"; exit 1; }
	$(OUT)/pd_tool xmb src/psp/ICON0.PNG src/psp/PIC1.PNG

clean:
	rm -rf $(OUT)

.PHONY: all test test-full psp-art clean FORCE
